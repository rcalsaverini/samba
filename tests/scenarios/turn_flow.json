{
  "kind": "turn_flow",
  "scenarios": [
    {"name": "plan run planned writes the plan and assumptions",
     "setup": {"stage": "plan", "prompt": "P0", "resume": false, "max_turns": 1},
     "reports": [{"outcome": "planned", "plan": "do x", "assumptions": "a1", "summary": "s", "cost_usd": 0.25}],
     "expect": {"result": {"kind": "finish", "event": "planned", "what": "planned", "summary": "s"},
                "requests": [{"prompt": "P0", "resume": false, "kind": "plan", "session_id": "s1", "max_budget_usd": null}],
                "sections": {"Plan": "do x", "Assumptions": "a1"}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 1, "cost_usd_total": 0.25, "plan_session_id": "s1"}}},
    {"name": "plan run with no plan fails and writes nothing",
     "setup": {"stage": "plan", "prompt": "P0", "resume": false, "max_turns": 1},
     "reports": [{"outcome": "planned", "plan": ""}],
     "expect": {"result": {"kind": "fail", "error": "planning run returned no valid outcome and plan"},
                "requests": [{"prompt": "P0", "resume": false, "kind": "plan", "session_id": "s1", "max_budget_usd": null}],
                "sections": {}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 1}}},
    {"name": "plan run blocked records questions",
     "setup": {"stage": "plan", "prompt": "P0", "resume": false, "max_turns": 1},
     "reports": [{"outcome": "blocked", "plan": "partial", "summary": "s",
                  "questions": [{"text": "Which?", "context": "c"}]}],
     "expect": {"result": {"kind": "finish", "event": "plan_blocked", "what": "blocked", "summary": "s"},
                "requests": [{"prompt": "P0", "resume": false, "kind": "plan", "session_id": "s1", "max_budget_usd": null}],
                "sections": {"Plan": "partial"}, "questions": 1, "validate_calls": 0,
                "task": {"turns_total": 1}}},
    {"name": "work run continues, fails validation once, then passes",
     "setup": {"stage": "work", "prompt": "P0", "resume": false, "max_turns": 5, "validate_enabled": true},
     "reports": [{"outcome": "continue", "cost_usd": 0.5}, {"outcome": "done", "cost_usd": 0.5},
                 {"outcome": "done", "summary": "ok", "cost_usd": 0.5}],
     "validate": [[false, "boom"], [true, ""]],
     "expect": {"result": {"kind": "finish", "event": "done", "what": "validation passed", "summary": "ok"},
                "requests": [
                  {"prompt": "P0", "resume": false, "kind": "work", "session_id": "s1", "max_budget_usd": null},
                  {"prompt": "CONT", "resume": true, "kind": "work", "session_id": "s1", "max_budget_usd": null},
                  {"prompt": "VF:boom", "resume": true, "kind": "work", "session_id": "s1", "max_budget_usd": null}],
                "sections": {}, "questions": 0, "validate_calls": 2,
                "task": {"turns_total": 3, "cost_usd_total": 1.5}}},
    {"name": "work run that never finishes exhausts max_turns",
     "setup": {"stage": "work", "prompt": "P0", "resume": false, "max_turns": 2},
     "reports": [{"outcome": "missing"}, {"outcome": "continue"}],
     "expect": {"result": {"kind": "fail", "error": "max_turns (2) exhausted"},
                "requests": [
                  {"prompt": "P0", "resume": false, "kind": "work", "session_id": "s1", "max_budget_usd": null},
                  {"prompt": "CONT", "resume": true, "kind": "work", "session_id": "s1", "max_budget_usd": null}],
                "sections": {}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 2}}},
    {"name": "work run with a missing session restarts with the first prompt",
     "setup": {"stage": "work", "prompt": "RESUME", "resume": true, "max_turns": 3},
     "task": {"session_id": "old"},
     "reports": [{"session_missing": true}, {"outcome": "done", "summary": "d"}],
     "expect": {"result": {"kind": "finish", "event": "done", "what": "done", "summary": "d"},
                "requests": [
                  {"prompt": "RESUME", "resume": true, "kind": "work", "session_id": "old", "max_budget_usd": null},
                  {"prompt": "FIRST", "resume": false, "kind": "work", "session_id": "s1", "max_budget_usd": null}],
                "sections": {}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 2, "session_id": "s1"}}},
    {"name": "work run blocked without a question synthesizes one",
     "setup": {"stage": "work", "prompt": "P0", "resume": false, "max_turns": 3},
     "reports": [{"outcome": "blocked", "summary": "stuck here", "denials": ["Bash(rm)"]}],
     "expect": {"result": {"kind": "finish", "event": "work_blocked", "what": "blocked", "summary": "stuck here"},
                "requests": [{"prompt": "P0", "resume": false, "kind": "work", "session_id": "s1", "max_budget_usd": null}],
                "sections": {}, "questions": 1, "validate_calls": 0,
                "log": ["permission denied: Bash(rm)"],
                "task": {"turns_total": 1}}},
    {"name": "work run stops before a turn when the budget is gone",
     "setup": {"stage": "work", "prompt": "P0", "resume": false, "max_turns": 3, "max_cost_usd": 1.0},
     "task": {"cost_usd_total": 1.5},
     "reports": [],
     "expect": {"result": {"kind": "finish", "event": "budget", "what": "budget exceeded ($1.50)", "summary": ""},
                "requests": [], "sections": {}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 0}}},
    {"name": "work run passes the remaining budget and stops when a turn spends it",
     "setup": {"stage": "work", "prompt": "P0", "resume": false, "max_turns": 3, "max_cost_usd": 1.0},
     "task": {"cost_usd_total": 0.25},
     "reports": [{"outcome": "continue", "summary": "more", "cost_usd": 0.75}],
     "expect": {"result": {"kind": "finish", "event": "budget", "what": "budget exceeded ($1.00)", "summary": "more"},
                "requests": [{"prompt": "P0", "resume": false, "kind": "work", "session_id": "s1", "max_budget_usd": 0.75}],
                "sections": {}, "questions": 0, "validate_calls": 0,
                "task": {"turns_total": 1, "cost_usd_total": 1.0}}}
  ]
}
