{
  "kind": "lifecycle",
  "scenarios": [
    {"name": "happy path with plan approval",
     "config": {"require_plan": true, "validate": "make check", "max_turns": 3},
     "status": "plan-todo",
     "reports": [{"outcome": "planned", "plan": "do x", "summary": "planned"},
                 {"outcome": "done", "summary": "built"}],
     "validator": [[true, "ok"], [true, "ok"]],
     "steps": [
       {"do": "tick", "status": "plan-review"},
       {"do": "plan_accept", "status": "work-todo"},
       {"do": "tick", "status": "work-review"},
       {"do": "work_accept", "result": "accepted", "status": "done"},
       {"do": "tick", "status": "done"}],
     "expect": {
       "vcs": ["exclude_samba_dir", "ensure_workspace", "ensure_workspace", "preflight",
               "preflight", "begin_merge", "commit_merge", "remove_workspace"],
       "validator": [["/ws/t1", "t1/validate-002.log"], ["/repo", "t1/accept-validate.log"]],
       "workspaces": [],
       "journal": ["dispatch", "workspace_created", "turn_start", "turn_end", "finished",
                   "dispatch", "turn_start", "turn_end", "validate", "finished",
                   "workspace_removed"],
       "log": ["merged abc1234, validated"]}},
    {"name": "work validation fails once and the agent gets the tail",
     "config": {"require_plan": false, "validate": "make check", "max_turns": 3},
     "status": "work-todo",
     "reports": [{"outcome": "done", "summary": "first"}, {"outcome": "done", "summary": "second"}],
     "validator": [[false, "FAILED test_x\n"], [true, "ok"]],
     "steps": [{"do": "tick", "status": "work-review"}],
     "expect": {
       "vcs": ["exclude_samba_dir", "ensure_workspace"],
       "validator": [["/ws/t1", "t1/validate-001.log"], ["/ws/t1", "t1/validate-002.log"]],
       "prompts_contain": [[1, "FAILED test_x"]],
       "workspaces": ["t1"],
       "journal": ["turn_start", "validate", "turn_start", "validate", "finished"],
       "log": []}},
    {"name": "accept time validation failure aborts the merge and the task stays in work-review",
     "config": {"require_plan": false, "validate": "make check", "max_turns": 3},
     "status": "work-todo",
     "reports": [{"outcome": "done", "summary": "built"}],
     "validator": [[true, "ok"], [false, "boom\n"]],
     "steps": [
       {"do": "tick", "status": "work-review"},
       {"do": "work_accept", "result": "refused", "status": "work-review",
        "message": "validation failed after merge; merge aborted, task stays in work-review: boom"}],
     "expect": {
       "vcs": ["exclude_samba_dir", "ensure_workspace", "preflight", "preflight", "begin_merge",
               "abort_merge"],
       "validator": [["/ws/t1", "t1/validate-001.log"], ["/repo", "t1/accept-validate.log"]],
       "workspaces": ["t1"],
       "journal": ["dispatch", "validate", "finished"],
       "log": ["work.accept: validation failed after merge: boom"]}},
    {"name": "merge conflict at accept leaves the task in work-review",
     "config": {"require_plan": false, "validate": null, "max_turns": 3},
     "status": "work-todo",
     "reports": [{"outcome": "done", "summary": "built"}],
     "validator": [],
     "merge": {"status": "conflict", "detail": "a.txt", "restore_point": "pre1"},
     "steps": [
       {"do": "tick", "status": "work-review"},
       {"do": "work_accept", "result": "refused", "status": "work-review",
        "message": "merge conflict in: a.txt; merge aborted, task stays in work-review"}],
     "expect": {
       "vcs": ["exclude_samba_dir", "ensure_workspace", "preflight", "preflight", "begin_merge"],
       "validator": [],
       "workspaces": ["t1"],
       "journal": ["dispatch", "finished"],
       "log": ["work.accept: merge failed (conflicts: a.txt)"]}},
    {"name": "blocked agent asks, the human answers, the task resumes and finishes",
     "config": {"require_plan": false, "validate": null, "max_turns": 3},
     "status": "work-todo",
     "reports": [{"outcome": "blocked", "summary": "stuck", "questions": [{"text": "Which db?", "context": "c"}]},
                 {"outcome": "done", "summary": "built"}],
     "validator": [],
     "steps": [
       {"do": "tick", "status": "question"},
       {"do": "answer", "text": "postgres", "status": "work-todo"},
       {"do": "tick", "status": "work-review"}],
     "expect": {
       "vcs": ["exclude_samba_dir", "ensure_workspace", "ensure_workspace"],
       "validator": [],
       "workspaces": ["t1"],
       "journal": ["dispatch", "turn_start", "finished", "dispatch", "turn_start", "finished"],
       "log": ["question.answer: t1/"]}}
  ]
}
