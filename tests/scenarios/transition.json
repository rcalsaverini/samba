{
  "kind": "transition",
  "scenarios": [
    {"name": "dispatch_plan clears the backoff and records the stage",
     "given": {"state": "plan-todo", "task": {"not_before": 500.0, "blocked_cause": "gave_up"}, "deps_met": true},
     "event": "dispatch_plan", "actor": "samba", "clock_time": 1000.0,
     "expect": {"fires": true, "state": "plan-running", "guards": ["deps_met"],
                "effects": ["not_before=None", "blocked_cause=None", "last_stage=plan", "first_dispatched_at=now"],
                "task": {"not_before": null, "blocked_cause": null, "last_stage": "plan", "first_dispatched_at": 1000.0}}},
    {"name": "dispatch_plan waits while dependencies are not met",
     "given": {"state": "plan-todo", "deps_met": false},
     "event": "dispatch_plan", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "dispatch_work keeps the first dispatch time",
     "given": {"state": "work-todo", "task": {"first_dispatched_at": 10.0, "last_stage": "plan"}, "deps_met": true},
     "event": "dispatch_work", "actor": "samba", "clock_time": 1000.0,
     "expect": {"fires": true, "state": "work-running", "guards": ["deps_met"],
                "effects": ["not_before=None", "blocked_cause=None", "last_stage=work", "first_dispatched_at=now"],
                "task": {"last_stage": "work"}}},
    {"name": "dispatch_work waits while dependencies are not met",
     "given": {"state": "work-todo", "deps_met": false},
     "event": "dispatch_work", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "dispatch_plan does not apply in work-todo",
     "given": {"state": "work-todo", "deps_met": true},
     "event": "dispatch_plan", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "route_to_plan when a plan is required and dependencies are met",
     "given": {"state": "work-todo", "deps_met": true, "plan_required": true},
     "event": "route_to_plan", "actor": "samba",
     "expect": {"fires": true, "state": "plan-todo", "guards": ["plan_required", "deps_met"], "effects": [], "task": {}}},
    {"name": "route_to_plan needs plan_required",
     "given": {"state": "work-todo", "deps_met": true, "plan_required": false},
     "event": "route_to_plan", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "route_to_plan needs dependencies met",
     "given": {"state": "work-todo", "deps_met": false, "plan_required": true},
     "event": "route_to_plan", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "planned resets attempts and errors",
     "given": {"state": "plan-running", "task": {"attempts": 2, "last_error": "x", "blocked_cause": "gave_up"}},
     "event": "planned", "actor": "samba",
     "expect": {"fires": true, "state": "plan-review", "guards": [],
                "effects": ["last_outcome=planned", "attempts=0", "last_error=None", "blocked_cause=None"],
                "task": {"last_outcome": "planned", "attempts": 0, "last_error": null, "blocked_cause": null}}},
    {"name": "plan_blocked asks a question",
     "given": {"state": "plan-running"},
     "event": "plan_blocked", "actor": "samba",
     "expect": {"fires": true, "state": "question", "guards": [],
                "effects": ["last_outcome=blocked", "blocked_cause=question"],
                "task": {"last_outcome": "blocked", "blocked_cause": "question"}}},
    {"name": "done resets attempts and errors",
     "given": {"state": "work-running", "task": {"attempts": 1, "last_error": "x"}},
     "event": "done", "actor": "samba",
     "expect": {"fires": true, "state": "work-review", "guards": [],
                "effects": ["last_outcome=done", "attempts=0", "last_error=None", "blocked_cause=None"],
                "task": {"last_outcome": "done", "attempts": 0, "last_error": null}}},
    {"name": "work_blocked asks a question",
     "given": {"state": "work-running"},
     "event": "work_blocked", "actor": "samba",
     "expect": {"fires": true, "state": "question", "guards": [],
                "effects": ["last_outcome=blocked", "blocked_cause=question"],
                "task": {"last_outcome": "blocked", "blocked_cause": "question"}}},
    {"name": "budget in plan-running sticks the task",
     "given": {"state": "plan-running"},
     "event": "budget", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_outcome=blocked", "blocked_cause=budget"],
                "task": {"last_outcome": "blocked", "blocked_cause": "budget"}}},
    {"name": "budget in work-running sticks the task",
     "given": {"state": "work-running"},
     "event": "budget", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_outcome=blocked", "blocked_cause=budget"],
                "task": {"last_outcome": "blocked", "blocked_cause": "budget"}}},
    {"name": "give_up in plan-running counts the attempt and keeps the error",
     "given": {"state": "plan-running", "task": {"attempts": 2}},
     "event": "give_up", "actor": "samba", "ctx": {"error": "boom"},
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["attempts+=1", "last_outcome=failed", "last_error=ctx", "blocked_cause=gave_up"],
                "task": {"attempts": 3, "last_outcome": "failed", "last_error": "boom", "blocked_cause": "gave_up"}}},
    {"name": "give_up in work-running counts the attempt and keeps the error",
     "given": {"state": "work-running", "task": {"attempts": 2}},
     "event": "give_up", "actor": "samba", "ctx": {"error": "boom"},
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["attempts+=1", "last_outcome=failed", "last_error=ctx", "blocked_cause=gave_up"],
                "task": {"attempts": 3, "last_outcome": "failed", "last_error": "boom", "blocked_cause": "gave_up"}}},
    {"name": "retry_plan schedules the retry after the delay",
     "given": {"state": "plan-running"},
     "event": "retry_plan", "actor": "samba", "ctx": {"error": "boom", "delay": 30}, "clock_time": 1000.0,
     "expect": {"fires": true, "state": "plan-todo", "guards": [],
                "effects": ["attempts+=1", "last_error=ctx", "not_before=retry", "last_outcome=retrying"],
                "task": {"attempts": 1, "last_error": "boom", "not_before": 1030.0, "last_outcome": "retrying"}}},
    {"name": "retry_work schedules the retry after the delay",
     "given": {"state": "work-running"},
     "event": "retry_work", "actor": "samba", "ctx": {"error": "boom", "delay": 30}, "clock_time": 1000.0,
     "expect": {"fires": true, "state": "work-todo", "guards": [],
                "effects": ["attempts+=1", "last_error=ctx", "not_before=retry", "last_outcome=retrying"],
                "task": {"attempts": 1, "last_error": "boom", "not_before": 1030.0, "last_outcome": "retrying"}}},
    {"name": "recover in plan-running changes nothing but the folder",
     "given": {"state": "plan-running", "task": {"attempts": 1}},
     "event": "recover", "actor": "samba",
     "expect": {"fires": true, "state": "plan-todo", "guards": [], "effects": [], "task": {}}},
    {"name": "recover in work-running changes nothing but the folder",
     "given": {"state": "work-running", "task": {"attempts": 1}},
     "event": "recover", "actor": "samba",
     "expect": {"fires": true, "state": "work-todo", "guards": [], "effects": [], "task": {}}},
    {"name": "dependency_discarded in plan-todo",
     "given": {"state": "plan-todo"},
     "event": "dependency_discarded", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=plan", "blocked_cause=dependency_discarded"],
                "task": {"last_stage": "plan", "blocked_cause": "dependency_discarded"}}},
    {"name": "dependency_discarded in work-todo",
     "given": {"state": "work-todo"},
     "event": "dependency_discarded", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=work", "blocked_cause=dependency_discarded"],
                "task": {"last_stage": "work", "blocked_cause": "dependency_discarded"}}},
    {"name": "dependency_cycle in plan-todo",
     "given": {"state": "plan-todo"},
     "event": "dependency_cycle", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=plan", "blocked_cause=dependency_cycle"],
                "task": {"last_stage": "plan", "blocked_cause": "dependency_cycle"}}},
    {"name": "dependency_cycle in work-todo",
     "given": {"state": "work-todo"},
     "event": "dependency_cycle", "actor": "samba",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=work", "blocked_cause=dependency_cycle"],
                "task": {"last_stage": "work", "blocked_cause": "dependency_cycle"}}},
    {"name": "plan.accept approves the plan and drops the session",
     "given": {"state": "plan-review", "task": {"session_id": "s1"}},
     "event": "plan.accept", "actor": "human",
     "expect": {"fires": true, "state": "work-todo", "guards": [],
                "effects": ["plan_approved=True", "session_id=None"],
                "task": {"plan_approved": true, "session_id": null}}},
    {"name": "plan.accept is not a samba event",
     "given": {"state": "plan-review"},
     "event": "plan.accept", "actor": "samba",
     "expect": {"fires": false}},
    {"name": "plan.reject changes nothing but the folder",
     "given": {"state": "plan-review", "task": {"session_id": "s1"}},
     "event": "plan.reject", "actor": "human",
     "expect": {"fires": true, "state": "plan-todo", "guards": [], "effects": [], "task": {}}},
    {"name": "plan.reject does not apply in work-review",
     "given": {"state": "work-review"},
     "event": "plan.reject", "actor": "human",
     "expect": {"fires": false}},
    {"name": "work.accept finishes the task",
     "given": {"state": "work-review"},
     "event": "work.accept", "actor": "human",
     "expect": {"fires": true, "state": "done", "guards": [], "effects": [], "task": {}}},
    {"name": "work.reject keeps the session",
     "given": {"state": "work-review", "task": {"session_id": "s1"}},
     "event": "work.reject", "actor": "human",
     "expect": {"fires": true, "state": "work-todo", "guards": [], "effects": [], "task": {}}},
    {"name": "work.reject_fresh drops the session",
     "given": {"state": "work-review", "task": {"session_id": "s1"}},
     "event": "work.reject_fresh", "actor": "human",
     "expect": {"fires": true, "state": "work-todo", "guards": [],
                "effects": ["session_id=None"], "task": {"session_id": null}}},
    {"name": "question.answer resumes the plan stage and dismisses open questions",
     "given": {"state": "question", "task": {"last_stage": "plan", "attempts": 2, "blocked_cause": "question",
               "questions": [{"id": "q1", "round": 1, "status": "open"}, {"id": "q2", "round": 1, "status": "answered", "answered_at": "earlier"}]}},
     "event": "question.answer", "actor": "human",
     "expect": {"fires": true, "state": "plan-todo", "guards": ["last_stage=plan"],
                "effects": ["attempts=0", "blocked_cause=None", "questions=dismiss_open"],
                "task": {"attempts": 0, "blocked_cause": null,
                            "questions": [{"id": "q1", "round": 1, "status": "dismissed", "answered_at": "2026-01-01T00:00:00+00:00"},
                                          {"id": "q2", "round": 1, "status": "answered", "answered_at": "earlier"}]}}},
    {"name": "question.answer resumes the work stage",
     "given": {"state": "question", "task": {"last_stage": "work", "attempts": 2, "blocked_cause": "question"}},
     "event": "question.answer", "actor": "human",
     "expect": {"fires": true, "state": "work-todo", "guards": ["last_stage=work"],
                "effects": ["attempts=0", "blocked_cause=None", "questions=dismiss_open"],
                "task": {"attempts": 0, "blocked_cause": null}}},
    {"name": "question.answer with no recorded stage goes to the plan stage",
     "given": {"state": "question", "task": {"last_stage": null, "attempts": 2, "blocked_cause": "question"}},
     "event": "question.answer", "actor": "human",
     "expect": {"fires": true, "state": "plan-todo", "guards": ["last_stage=unset"],
                "effects": ["attempts=0", "blocked_cause=None", "last_stage=plan", "questions=dismiss_open"],
                "task": {"attempts": 0, "blocked_cause": null, "last_stage": "plan"}}},
    {"name": "question.answer with no recorded stage, hand moved to work-todo",
     "given": {"state": "question", "task": {"last_stage": null, "attempts": 2, "blocked_cause": "question"}},
     "event": "question.answer", "actor": "human", "hand_move_to": "work-todo",
     "expect": {"fires": true, "state": "work-todo", "guards": ["last_stage=unset"],
                "effects": ["attempts=0", "blocked_cause=None", "last_stage=work", "questions=dismiss_open"],
                "task": {"attempts": 0, "blocked_cause": null, "last_stage": "work"}}},
    {"name": "task.retry resumes the plan stage",
     "given": {"state": "stuck", "task": {"last_stage": "plan", "attempts": 3, "blocked_cause": "gave_up"}},
     "event": "task.retry", "actor": "human",
     "expect": {"fires": true, "state": "plan-todo", "guards": ["last_stage=plan"],
                "effects": ["attempts=0", "blocked_cause=None"],
                "task": {"attempts": 0, "blocked_cause": null}}},
    {"name": "task.retry resumes the work stage",
     "given": {"state": "stuck", "task": {"last_stage": "work", "attempts": 3, "blocked_cause": "gave_up"}},
     "event": "task.retry", "actor": "human",
     "expect": {"fires": true, "state": "work-todo", "guards": ["last_stage=work"],
                "effects": ["attempts=0", "blocked_cause=None"],
                "task": {"attempts": 0, "blocked_cause": null}}},
    {"name": "task.retry with no recorded stage goes to the plan stage",
     "given": {"state": "stuck", "task": {"attempts": 3, "blocked_cause": "dependency_cycle"}},
     "event": "task.retry", "actor": "human",
     "expect": {"fires": true, "state": "plan-todo", "guards": ["last_stage=unset"],
                "effects": ["attempts=0", "blocked_cause=None", "last_stage=plan"],
                "task": {"attempts": 0, "blocked_cause": null, "last_stage": "plan"}}},
    {"name": "task.retry with no recorded stage, hand moved to work-todo",
     "given": {"state": "stuck", "task": {"attempts": 3, "blocked_cause": "dependency_cycle"}},
     "event": "task.retry", "actor": "human", "hand_move_to": "work-todo",
     "expect": {"fires": true, "state": "work-todo", "guards": ["last_stage=unset"],
                "effects": ["attempts=0", "blocked_cause=None", "last_stage=work"],
                "task": {"attempts": 0, "blocked_cause": null, "last_stage": "work"}}},
    {"name": "task.stop in plan-running",
     "given": {"state": "plan-running"},
     "event": "task.stop", "actor": "human",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=plan", "blocked_cause=stopped"],
                "task": {"last_stage": "plan", "blocked_cause": "stopped"}}},
    {"name": "task.stop in work-running",
     "given": {"state": "work-running"},
     "event": "task.stop", "actor": "human",
     "expect": {"fires": true, "state": "stuck", "guards": [],
                "effects": ["last_stage=work", "blocked_cause=stopped"],
                "task": {"last_stage": "work", "blocked_cause": "stopped"}}},
    {"name": "task.stop does not apply to a task that is not running",
     "given": {"state": "plan-todo"},
     "event": "task.stop", "actor": "human",
     "expect": {"fires": false}},
    {"name": "task.discard from plan-todo",
     "given": {"state": "plan-todo"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from plan-running",
     "given": {"state": "plan-running"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from plan-review",
     "given": {"state": "plan-review"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from work-todo",
     "given": {"state": "work-todo"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from work-running",
     "given": {"state": "work-running"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from work-review",
     "given": {"state": "work-review"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from question",
     "given": {"state": "question"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard from stuck",
     "given": {"state": "stuck"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": true, "state": "discarded", "guards": [], "effects": [], "task": {}}},
    {"name": "task.discard does not apply to a done task",
     "given": {"state": "done"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": false}},
    {"name": "task.discard does not apply to a discarded task",
     "given": {"state": "discarded"}, "event": "task.discard", "actor": "human",
     "expect": {"fires": false}}
  ]
}
