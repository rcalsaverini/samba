{
  "kind": "turn_decision",
  "scenarios": [
    {"name": "work done, validation on", "stage": "work", "validate": true,
     "report": {"outcome": "done", "summary": "all good"},
     "expect": {"action": "run_validation", "summary": "all good"}},
    {"name": "work done, validation off", "stage": "work", "validate": false,
     "report": {"outcome": "done", "summary": "all good"},
     "expect": {"action": "finish", "event": "done", "what": "done", "summary": "all good"}},
    {"name": "work blocked with a question", "stage": "work", "validate": true,
     "report": {"outcome": "blocked", "summary": "need input", "questions": [{"text": "Which one?", "context": "two options"}]},
     "expect": {"action": "record_questions", "event": "work_blocked", "what": "blocked", "summary": "need input"}},
    {"name": "work blocked without a question still records", "stage": "work", "validate": true,
     "report": {"outcome": "blocked", "summary": "denied", "denials": ["Bash(rm)"]},
     "expect": {"action": "record_questions", "event": "work_blocked", "what": "blocked", "summary": "denied"}},
    {"name": "work continue", "stage": "work", "validate": true,
     "report": {"outcome": "continue", "summary": "more to do"},
     "expect": {"action": "continue"}},
    {"name": "work missing outcome continues", "stage": "work", "validate": true,
     "report": {"outcome": "missing"},
     "expect": {"action": "continue"}},
    {"name": "work planned outcome continues", "stage": "work", "validate": false,
     "report": {"outcome": "planned", "plan": "p"},
     "expect": {"action": "continue"}},
    {"name": "work stalled", "stage": "work", "validate": true,
     "report": {"failure": {"kind": "stalled", "detail": "stalled for 600s"}},
     "expect": {"action": "fail", "error": "stalled for 600s"}},
    {"name": "work timeout", "stage": "work", "validate": true,
     "report": {"failure": {"kind": "timeout", "detail": "timed out after 3600s"}},
     "expect": {"action": "fail", "error": "timed out after 3600s"}},
    {"name": "work error", "stage": "work", "validate": true,
     "report": {"failure": {"kind": "error", "detail": "claude exited with code 1"}},
     "expect": {"action": "fail", "error": "claude exited with code 1"}},
    {"name": "work budget exceeded after a turn keeps the summary", "stage": "work", "validate": true,
     "budget": {"cap": 1, "spent": 1.234},
     "report": {"outcome": "done", "summary": "ran out"},
     "expect": {"action": "finish", "event": "budget", "what": "budget exceeded ($1.23)", "summary": "ran out"}},
    {"name": "work budget exceeded wins over blocked", "stage": "work", "validate": true,
     "budget": {"cap": 1, "spent": 2},
     "report": {"outcome": "blocked", "summary": "s"},
     "expect": {"action": "finish", "event": "budget", "what": "budget exceeded ($2.00)", "summary": "s"}},
    {"name": "work failure wins over budget", "stage": "work", "validate": true,
     "budget": {"cap": 1, "spent": 2},
     "report": {"failure": {"kind": "error", "detail": "boom"}},
     "expect": {"action": "fail", "error": "boom"}},
    {"name": "work under the cap is not budget", "stage": "work", "validate": false,
     "budget": {"cap": 5, "spent": 4.99},
     "report": {"outcome": "done"},
     "expect": {"action": "finish", "event": "done", "what": "done", "summary": ""}},
    {"name": "plan planned with a plan", "stage": "plan", "validate": true,
     "report": {"outcome": "planned", "plan": "do x", "summary": "s"},
     "expect": {"action": "finish", "event": "planned", "what": "planned", "summary": "s"}},
    {"name": "plan planned without a plan fails", "stage": "plan", "validate": true,
     "report": {"outcome": "planned", "plan": ""},
     "expect": {"action": "fail", "error": "planning run returned no valid outcome and plan"}},
    {"name": "plan blocked with a plan", "stage": "plan", "validate": true,
     "report": {"outcome": "blocked", "plan": "partial", "summary": "s"},
     "expect": {"action": "record_questions", "event": "plan_blocked", "what": "blocked", "summary": "s"}},
    {"name": "plan blocked without a plan fails", "stage": "plan", "validate": true,
     "report": {"outcome": "blocked", "plan": ""},
     "expect": {"action": "fail", "error": "planning run returned no valid outcome and plan"}},
    {"name": "plan missing outcome fails", "stage": "plan", "validate": true,
     "report": {"outcome": "missing", "plan": "p"},
     "expect": {"action": "fail", "error": "planning run returned no valid outcome and plan"}},
    {"name": "plan continue fails", "stage": "plan", "validate": true,
     "report": {"outcome": "continue", "plan": "p"},
     "expect": {"action": "fail", "error": "planning run returned no valid outcome and plan"}},
    {"name": "plan done fails", "stage": "plan", "validate": true,
     "report": {"outcome": "done", "plan": "p"},
     "expect": {"action": "fail", "error": "planning run returned no valid outcome and plan"}},
    {"name": "plan failure", "stage": "plan", "validate": true,
     "report": {"failure": {"kind": "timeout", "detail": "timed out after 600s"}},
     "expect": {"action": "fail", "error": "timed out after 600s"}},
    {"name": "plan budget exceeded after the run", "stage": "plan", "validate": true,
     "budget": {"cap": 0.5, "spent": 0.75},
     "report": {"outcome": "planned", "plan": "p", "summary": "s"},
     "expect": {"action": "finish", "event": "budget", "what": "budget exceeded ($0.75)", "summary": "s"}},
    {"name": "plan failure wins over budget", "stage": "plan", "validate": true,
     "budget": {"cap": 0.5, "spent": 0.75},
     "report": {"failure": {"kind": "error", "detail": "boom"}},
     "expect": {"action": "fail", "error": "boom"}}
  ]
}
