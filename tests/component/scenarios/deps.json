{
  "kind": "deps",
  "scenarios": [
    {"name": "no dependencies is ready",
     "tasks": [{"id": "a", "status": "work-todo"}], "task": "a",
     "expect": {"kind": "ready", "waiting": [], "unknown": []}},
    {"name": "all dependencies done is ready",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b", "c"]}, {"id": "b", "status": "done"}, {"id": "c", "status": "done"}], "task": "a",
     "expect": {"kind": "ready", "waiting": [], "unknown": []}},
    {"name": "a dependency still to do is waiting",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b", "c"]}, {"id": "b", "status": "done"}, {"id": "c", "status": "work-todo"}], "task": "a",
     "expect": {"kind": "waiting", "waiting": ["c"], "unknown": []}},
    {"name": "a discarded dependency",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b"]}, {"id": "b", "status": "discarded"}], "task": "a",
     "expect": {"kind": "discarded", "waiting": ["b"], "unknown": []}},
    {"name": "discarded beats waiting",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b", "c"]}, {"id": "b", "status": "work-running"}, {"id": "c", "status": "discarded"}], "task": "a",
     "expect": {"kind": "discarded", "waiting": ["b", "c"], "unknown": []}},
    {"name": "an unknown id waits and is reported",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["ghost"]}], "task": "a",
     "expect": {"kind": "waiting", "waiting": ["ghost"], "unknown": ["ghost"]}},
    {"name": "unknown next to a done dependency",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b", "ghost"]}, {"id": "b", "status": "done"}], "task": "a",
     "expect": {"kind": "waiting", "waiting": ["ghost"], "unknown": ["ghost"]}},
    {"name": "a task depending on itself is a cycle",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["a"]}], "task": "a",
     "expect": {"kind": "cycle", "waiting": [], "unknown": []}},
    {"name": "a two node cycle",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b"]}, {"id": "b", "status": "work-todo", "depends_on": ["a"]}], "task": "a",
     "expect": {"kind": "cycle", "waiting": [], "unknown": []}},
    {"name": "a three node cycle",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b"]}, {"id": "b", "status": "plan-todo", "depends_on": ["c"]}, {"id": "c", "status": "stuck", "depends_on": ["a"]}], "task": "a",
     "expect": {"kind": "cycle", "waiting": [], "unknown": []}},
    {"name": "a cycle through a done task is not a cycle",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b"]}, {"id": "b", "status": "done", "depends_on": ["a"]}], "task": "a",
     "expect": {"kind": "ready", "waiting": [], "unknown": []}},
    {"name": "a cycle that does not include the task",
     "tasks": [{"id": "a", "status": "work-todo", "depends_on": ["b"]}, {"id": "b", "status": "work-todo", "depends_on": ["c"]}, {"id": "c", "status": "work-todo", "depends_on": ["b"]}], "task": "a",
     "expect": {"kind": "waiting", "waiting": ["b"], "unknown": []}}
  ]
}
